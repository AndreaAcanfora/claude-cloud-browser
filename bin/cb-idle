#!/usr/bin/env bash
# cb-idle: run every minute by cb-idle.timer, as the browser's user.
#
# - Inside a CB_CHROME_KEEP_AWAKE window the browser is started if needed and
#   every CB_CHROME_KEEP_AWAKE_URLS page is kept open (reopened if closed).
# - Outside those windows, with CB_CHROME_IDLE_STOP=<minutes>, the browser is
#   stopped once nobody has used it for that long. cb-wake-proxy records each
#   use and starts it again on the next DevTools or VNC connection.
#
#   cb-idle          one check (what the timer runs)
#   cb-idle --check  validate the configuration and exit

set -euo pipefail

CONF=${CB_IDLE_CONF:-/etc/claude-cloud-browser/idle.conf}
# shellcheck disable=SC1090
[[ -f $CONF ]] && . "$CONF"
: "${CB_CHROME_IDLE_STOP:=off}" "${CB_CHROME_KEEP_AWAKE:=}" "${CB_CHROME_KEEP_AWAKE_URLS:=}"
: "${CB_TIMEZONE:=}" "${CB_CHROME_CDP_PORT:=9222}"
[[ -n $CB_TIMEZONE ]] && export TZ=$CB_TIMEZONE

UNIT=cb-chrome.service
RUN_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
STAMP=$RUN_DIR/cb-activity
TABS=$RUN_DIR/cb-keep-awake-tabs
DEVTOOLS="http://127.0.0.1:$CB_CHROME_CDP_PORT"

die() { echo "cb-idle: $*" >&2; exit 1; }

day_num() {
  case ${1,,} in
    mon) echo 1 ;; tue) echo 2 ;; wed) echo 3 ;; thu) echo 4 ;;
    fri) echo 5 ;; sat) echo 6 ;; sun) echo 7 ;;
    *) return 1 ;;
  esac
}

# day_matches SPEC DAY: SPEC is "Mon..Fri", "Sat,Sun", "Mon..Wed,Fri"...
# DAY is 1 (Mon) to 7 (Sun); 0 never matches, which validates the whole SPEC.
day_matches() {
  local spec=$1 today=$2 item a b items
  IFS=, read -r -a items <<<"$spec"
  for item in "${items[@]}"; do
    if [[ $item == *..* ]]; then
      a=$(day_num "${item%%..*}") || die "bad day in '$spec' (use Mon..Sun)"
      b=$(day_num "${item##*..}") || die "bad day in '$spec' (use Mon..Sun)"
      if (( a <= b )); then
        (( today >= a && today <= b )) && return 0
      else
        (( today != 0 && (today >= a || today <= b) )) && return 0
      fi
    else
      a=$(day_num "$item") || die "bad day in '$spec' (use Mon..Sun)"
      (( today == a )) && return 0
    fi
  done
  return 1
}

to_minutes() {
  local h=${1%%:*} m=${1##*:}
  echo $((10#$h * 60 + 10#$m))
}

# in_window [check]: windows are ";"-separated, each "[DAYS] HH:MM-HH:MM".
# With "check", every window is validated and nothing matches.
in_window() {
  local check=${1:-} win days range extra from to today now wins
  if [[ -n $check ]]; then today=0; else today=$(date +%u); fi
  now=$(to_minutes "$(date +%H:%M)")
  IFS=';' read -r -a wins <<<"$CB_CHROME_KEEP_AWAKE"
  for win in "${wins[@]}"; do
    read -r days range extra <<<"$win" || true
    [[ -n ${days:-} ]] || continue
    [[ -z ${extra:-} ]] || die "bad window '$win' (use: Mon..Fri 07:00-18:00)"
    if [[ -z ${range:-} ]]; then range=$days days=Mon..Sun; fi
    [[ $range =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]] ||
      die "bad time range in '$win' (use HH:MM-HH:MM)"
    from=$(to_minutes "${range%-*}")
    to=$(to_minutes "${range#*-}")
    (( from < to )) || die "window '$win' must end after it starts (split windows that cross midnight)"
    if day_matches "$days" "$today" && (( now >= from && now < to )); then
      return 0
    fi
  done
  return 1
}

# Keep each CB_CHROME_KEEP_AWAKE_URLS page open. We remember the tab we opened
# (by DevTools id), not its address, so a page that redirects (a login screen,
# a workspace URL) is never opened twice.
ensure_keep_awake_tabs() {
  [[ -n $CB_CHROME_KEEP_AWAKE_URLS ]] || return 0
  local list="" url id new_id tabs_new="" _
  for _ in $(seq 1 30); do
    list=$(curl -fsS -m 3 "$DEVTOOLS/json/list" 2>/dev/null) && break
    sleep 1
  done
  [[ -n $list ]] || die "browser DevTools not reachable on $DEVTOOLS"
  for url in $CB_CHROME_KEEP_AWAKE_URLS; do
    id=$(awk -v u="$url" '$1 == u { print $2 }' "$TABS" 2>/dev/null || true)
    if [[ -n $id ]] && jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$list" >/dev/null; then
      tabs_new+="$url $id"$'\n'
      continue
    fi
    new_id=$(curl -fsS -m 10 -X PUT "$DEVTOOLS/json/new?$(jq -rn --arg u "$url" '$u | @uri')" | jq -r '.id')
    echo "keep-awake: opened $url"
    tabs_new+="$url $new_id"$'\n'
  done
  printf '%s' "$tabs_new" >"$TABS"
}

if [[ ${1:-} == --check ]]; then
  [[ $CB_CHROME_IDLE_STOP == off || $CB_CHROME_IDLE_STOP =~ ^[1-9][0-9]*$ ]] ||
    die "CB_CHROME_IDLE_STOP must be off or a number of minutes, got: $CB_CHROME_IDLE_STOP"
  [[ -z $CB_TIMEZONE || -f /usr/share/zoneinfo/$CB_TIMEZONE ]] || die "unknown CB_TIMEZONE: $CB_TIMEZONE"
  in_window check || true
  for url in $CB_CHROME_KEEP_AWAKE_URLS; do
    [[ $url =~ ^https?:// ]] || die "CB_CHROME_KEEP_AWAKE_URLS: not an http(s) URL: $url"
  done
  exit 0
fi

if [[ -n $CB_CHROME_KEEP_AWAKE ]] && in_window; then
  if ! systemctl --user is-active --quiet "$UNIT"; then
    echo "keep-awake window: starting the browser"
    systemctl --user start "$UNIT"
  fi
  ensure_keep_awake_tabs
  exit 0
fi

[[ $CB_CHROME_IDLE_STOP == off ]] && exit 0
systemctl --user is-active --quiet "$UNIT" || exit 0

last=$(date -d "$(systemctl --user show "$UNIT" -p ActiveEnterTimestamp --value)" +%s)
if [[ -f $STAMP ]]; then
  used=$(stat -c %Y "$STAMP")
  (( used > last )) && last=$used
fi
idle=$(( ($(date +%s) - last) / 60 ))
if (( idle >= CB_CHROME_IDLE_STOP )); then
  echo "unused for $idle min: stopping the browser (it starts again on the next connection)"
  systemctl --user stop "$UNIT"
fi
