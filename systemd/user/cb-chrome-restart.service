[Unit]
Description=claude-cloud-browser: nightly browser restart (closes old tabs, keeps logins)

[Service]
Type=oneshot
# Tabs left open for days are what fills memory. The profile keeps cookies
# and logins, so a restart only closes tabs.
# try-restart: a browser stopped for being idle stays stopped.
ExecStart=/usr/bin/systemctl --user try-restart cb-chrome.service
