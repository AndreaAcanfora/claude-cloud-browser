# Copy to .env (next to install.sh) or to /etc/claude-cloud-browser/install.env.
# Every value is optional; defaults are shown. Never put passwords or tokens here:
# the installer does not need any.

# Dedicated non-root user that owns Claude Code and the browser.
CB_USER=claude

# Public key allowed to log in as CB_USER (for example from Termius). Quote it.
CB_SSH_PUBKEY='ssh-ed25519 AAAA... my-phone'

# yes = also copy root's authorized_keys to CB_USER (keys injected by the cloud provider).
CB_COPY_ROOT_KEYS=no

# auto|yes = key-only SSH once both CB_USER and root have a key. no = leave sshd alone.
CB_HARDEN_SSH=auto

# Minimum total swap in GB.
CB_SWAP_GB=4

# Cap for everything CB_USER runs (browser, Claude Code, tools).
CB_MEMORY_MAX=3G
CB_CPU_QUOTA=200%

# Virtual display and browser window.
CB_DISPLAY=:99
CB_SCREEN=1280x800x24

# Local ports (bound to 127.0.0.1 only).
CB_CDP_PORT=9222
CB_VNC_PORT=5900
CB_NOVNC_PORT=6080

# Tailscale machine name and the HTTPS port noVNC is served on inside the tailnet.
CB_TS_HOSTNAME=claude-vps
CB_TS_HTTPS_PORT=443

# Versions. "lts" = newest Node LTS.
CB_NODE_VERSION=lts
CB_PLAYWRIGHT_VERSION=1.64.1
CB_PLAYWRIGHT_MCP_VERSION=0.0.83
